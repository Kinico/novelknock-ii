# linux-wallpaperengine with NovelKnock per-monitor zoom + X/Y offset
# (reads ~/.config/linux-wallpaperengine/view.json, changed live from the Knock sidebar)
# Based on the upstream Arch PKGBUILD by Alexis Maiquez <aur@almamu.com>
pkgname=linux-wallpaperengine-novelknock-git
_pkgname=linux-wallpaperengine
_srcdir=linux-wallpaperengine-src
_commit=a0ddce586e9ff12e9d31ca6b103f6036cc1b68fe # the commit the patch was made against
pkgver=r643.a0ddce58
pkgrel=1
pkgdesc="Steam's Wallpaper Engine on Linux, with per-monitor zoom and position"
arch=('x86_64')
url="https://github.com/Almamu/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'freeglut' 'libpulse' 'libcups' 'at-spi2-core' 'nss' 'libxcomposite' 'libxdamage' 'nspr')
makedepends=('git' 'cmake' 'sdl2' 'glm' 'wayland-protocols' 'xorg-xrandr')
provides=('linux-wallpaperengine' 'linux-wallpaperengine-git')
conflicts=('linux-wallpaperengine' 'linux-wallpaperengine-git')
source=("${_srcdir}::git+https://github.com/Almamu/linux-wallpaperengine.git#commit=${_commit}"
        "novelknock-view-tweaks.patch")
sha512sums=('SKIP' 'SKIP')

pkgver() {
    cd "$_srcdir"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_srcdir"
    git submodule update --init --recursive
    git -c protocol.file.allow=always submodule update
    git apply "$srcdir/novelknock-view-tweaks.patch"
}

build() {
    cmake -B build -S "$_srcdir" \
        -DCMAKE_BUILD_TYPE='Release' \
        -DCMAKE_INSTALL_PREFIX="/opt/${_pkgname}" \
        -Wno-dev \
        -DCMAKE_CXX_FLAGS="-ffat-lto-objects -Wno-builtin-macro-redefined" \
        -DCMAKE_C_FLAGS="-Wno-builtin-macro-redefined"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -d -m755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/${_pkgname}" << EOS
#!/bin/bash
export LD_LIBRARY_PATH="/opt/${_pkgname}/lib:\$LD_LIBRARY_PATH"
cd /opt/${_pkgname}; exec ./${_pkgname} "\$@"
EOS
    chmod +x "${pkgdir}/usr/bin/${_pkgname}"
    chmod +x "${pkgdir}/opt/${_pkgname}/linux-wallpaperengine"
}
